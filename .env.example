# Public address and TLS certificate contact
DOMAIN=news.example.com
CADDY_EMAIL=admin@example.com

# Required production credentials (do not use the sample values)
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=replace-with-a-private-admin-name
ADMIN_PASSWORD=replace-with-a-long-unique-password
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id

# Runtime configuration
DATABASE_URL=sqlite:////data/news.db
# AI_PROVIDER: auto (anahtar varsa OpenAI, yoksa Ollama), openai veya ollama
# Ücretsiz yerel kurulum için varsayılan Ollama'dır.
AI_PROVIDER=ollama
# Yalnızca AI_PROVIDER=openai olduğunda doldurun.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT=120
# Tam Oracle kurulumu için http://ollama:11434 bırakın. Hibrit kurulumda
# kişisel bilgisayarınızdaki Tailscale IP/DNS adresini yazın; örnek:
# http://100.64.0.10:11434
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=30m
AI_BATCH_SIZE=1
# Yerel CPU'da her turda tek haber işlenir. Uzun süren işlem devam ederken
# yeni bir tur açılmaz; böylece kaynak taraması ve arayüz akıcı kalır.
AI_WORKER_INTERVAL_SECONDS=150
# Bir haber en fazla üç kez otomatik denenir. Başarısız kalırsa editörün
# manuel yeniden denemesi beklenir.
AI_MAX_ATTEMPTS=3
AI_RETRY_DELAY_MINUTES=15
# Sadece son 24 saatin haberleri AI kuyruğuna alınır. Puanı 8+ olanlar
# editöryal inceleme için hazırlanır.
AI_QUEUE_MAX_AGE_HOURS=24
AI_REVIEW_MIN_IMPORTANCE=8
# Türkçe kalite denetimi başarısız olduğunda otomatik yeniden üretim sayısı.
AI_TURKISH_QUALITY_RETRIES=1
INSTAGRAM_NUM_PREDICT=320
MAX_CONTENT_LENGTH=800
AI_TIMEOUT=120
AI_LOGGING=true
OLLAMA_NUM_CTX=1024
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=120
OLLAMA_TOP_K=20
OLLAMA_TOP_P=0.8

# News retention: 90 gün aktif, 1 yıla kadar arşiv, ardından yedekli temizlik
NEWS_RETENTION_ENABLED=true
NEWS_ARCHIVE_AFTER_DAYS=90
NEWS_DELETE_AFTER_DAYS=365

# Kaynak, bu kadar ardışık hata sonrası otomatik pasife alınır.
SOURCE_AUTO_DISABLE_FAILURES=3
# Aynı RSS adresleri tek kez okunur. Bu sayı, farklı genel RSS adreslerinin
# aynı anda en fazla kaç tanesinin indirileceğini belirler.
RSS_FETCH_WORKERS=4
NEWS_SCAN_INTERVAL_MINUTES=5
